# Copy to .env (gitignored). renewal run loads it via python-dotenv.
#
# Only the provider used by a config is required for that run. Secrets are
# never logged — only presence (set/unset) and a credential-free URL.

# --- vLLM (provider: vllm, MPCDF cluster) ---------------------------------
# One model per endpoint. Endpoint resolution order:
#   explicit constructor arg -> MPCDF_VLLM_ENDPOINTS[model]
#   -> MPCDF_VLLM_ENDPOINT_URL (single-endpoint fallback).
# API key resolution: MPCDF_VLLM_API_KEYS[endpoint] -> MPCDF_VLLM_API_KEY
#   -> "local-no-auth" placeholder.

# Single exposed model (simplest):
MPCDF_VLLM_ENDPOINT_URL=https://<host>/v1
MPCDF_VLLM_MODEL=Qwen/Qwen3-30B-A3B
# optional
# MPCDF_VLLM_API_KEY=

# Per-model endpoint map (deployment-specific, never committed):
# MPCDF_VLLM_ENDPOINTS={"Qwen/Qwen3-1.7B":"https://host-a/v1","Qwen/Qwen3-30B-A3B":"https://host-b/v1"}
# optional per-endpoint keys; falls back to MPCDF_VLLM_API_KEY:
# MPCDF_VLLM_API_KEYS={"https://host-b/v1":"secret"}
